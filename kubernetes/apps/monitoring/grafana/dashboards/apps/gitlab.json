{
 "title": "GitLab",
 "uid": "gitlab",
 "tags": [
  "gitlab",
  "apps"
 ],
 "description": "GitLab CE (Omnibus, single pod) in the gitlab namespace. Four exporters in one pod, scraped by kubernetes/apps/gitlab/gitlab/app/podmonitor.yaml: Rails/Puma, Workhorse, Sidekiq and Gitaly. PostgreSQL is the shared CNPG cluster and not shown here; the runner's job pods are counted from kube-state-metrics.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timezone": "",
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Health",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Scrape targets",
   "description": "Rails, Workhorse, Sidekiq and Gitaly endpoints. 0 means at least one is not scraped; check the CiliumNetworkPolicy ports first.",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(up{namespace=\"gitlab\", job=~\"gitlab-.*\"})",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "all up",
         "color": "green"
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
