{
 "title": "Gatus \u2014 Endpoint Health",
 "uid": "gatus-endpoints",
 "tags": [
  "gatus",
  "observability"
 ],
 "description": "Gatus probes 30 endpoints from inside the cluster. There is no community dashboard for it, so this is built against the six gatus_results_* series it exposes.\n\nIts view is deliberately different from Prometheus scrape health: Gatus checks whether a service ANSWERS CORRECTLY, not whether it hands out metrics. A component can be `up` and still be failing its own health check.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "time": {
  "from": "now-12h",
  "to": "now"
 },
 "timezone": "",
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Endpoints failing",
   "description": "",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(gatus_results_endpoint_success == 0) or vector(0)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Endpoints watched",
   "description": "",
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 6,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(gatus_results_endpoint_success)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Slowest endpoint",
   "description": "",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 11,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(gatus_results_duration_seconds)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Nearest certificate expiry",
   "description": "This cluster uses Let's Encrypt's short-lived certificates (duration 160h, about 6.7 days), so cert-manager renews roughly two days before expiry. A failed renewal leaves two days of headroom, not thirty -- which is why this has a panel of its own.",
   "gridPos": {
    "h": 5,
    "w": 7,
    "x": 17,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(gatus_results_certificate_expiration_seconds)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 172800
       },
       {
        "color": "green",
        "value": 259200
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "row",
   "title": "Per endpoint",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "panels": []
  },
  {
   "id": 6,
   "type": "table",
   "title": "Currently failing",
   "description": "Empty in normal operation.",
   "gridPos": {
    "h": 8,
    "w": 10,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "gatus_results_endpoint_success == 0",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "namespace": true,
       "container": true,
       "endpoint": true,
       "pod": true,
       "service": true,
       "prometheus": true,
       "prometheus_replica": true,
       "Value": true,
       "key": true
      },
      "renameByName": {
       "name": "Endpoint",
       "group": "Group",
       "type": "Type"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "countRows": false,
     "fields": ""
    }
   }
  },
  {
   "id": 7,
   "type": "table",
   "title": "All endpoints",
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 14,
    "x": 10,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "gatus_results_endpoint_success",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "namespace": true,
       "container": true,
       "endpoint": true,
       "pod": true,
       "service": true,
       "prometheus": true,
       "prometheus_replica": true,
       "key": true
      },
      "renameByName": {
       "name": "Endpoint",
       "group": "Group",
       "type": "Type",
       "Value": "Up"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "countRows": false,
     "fields": ""
    },
    "sortBy": [
     {
      "displayName": "Group",
      "desc": false
     }
    ]
   }
  },
  {
   "id": 8,
   "type": "row",
   "title": "Trends",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "panels": []
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Response time by endpoint",
   "description": "Sudden steps usually mean a dependency changed, not the endpoint itself.",
   "gridPos": {
    "h": 8,
    "w": 14,
    "x": 0,
    "y": 15
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "gatus_results_duration_seconds",
     "legendFormat": "{{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Failures over time",
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 10,
    "x": 14,
    "y": 15
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (name) (1 - gatus_results_endpoint_success)",
     "legendFormat": "{{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 40,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal",
