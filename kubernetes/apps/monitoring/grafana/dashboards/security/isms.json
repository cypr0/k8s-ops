  {
   "id": 8,
   "type": "gauge",
   "title": "Erfüllungsgrad",
   "description": "Share of assessed controls the committed assessment reports as satisfied. Read it together with the panel to its right: a satisfied control may rest on a machine check or on the operator's own attestation, and this figure does not distinguish them.",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum(isms_controls_by_verdict{verdict=\"pass\"}) / sum(isms_controls_assessed)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 60
       },
       {
        "color": "yellow",
        "value": 80
       },
       {
        "color": "green",
        "value": 95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdLabels": false,
    "showThresholdMarkers": true
   }
  },
  {
   "id": 9,
   "type": "gauge",
   "title": "davon maschinell belegt",
   "description": "Share of profile controls that are satisfied AND decided by a check rather than by an attestation. This is the number that cannot be talked up: a failing check does not become a pass because the operator says so. The gap to the gauge on the left is the part of the posture that rests on one person's word, reviewed on a date.",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 6,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * count(isms_control_verdict{verdict=\"pass\"} * on(control) group_left(basis) isms_control_evidence_basis{basis=~\"machine|mixed\"}) / scalar(isms_profile_controls)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 40
       },
       {
        "color": "yellow",
        "value": 60
       },
       {
        "color": "green",
        "value": 80
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdLabels": false,
    "showThresholdMarkers": true
   }
  },
