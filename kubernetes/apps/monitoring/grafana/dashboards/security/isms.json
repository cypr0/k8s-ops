      "uid": "prometheus"
     },
     "expr": "isms_control_verdict{verdict!=\"pass\"}",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
