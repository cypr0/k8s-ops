  {
   "id": 6,
   "type": "stat",
   "title": "Exporter hat Daten",
   "description": "0 means the exporter has never successfully read the metrics file, so every ISMS panel below is empty rather than reassuring. It deliberately does not emit zeroed ISMS metrics in that state: a zero deviation count nobody measured is the most dangerous number this dashboard could show.",
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 19,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
