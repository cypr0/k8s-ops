{
 "title": "ISMS — Compliance as Code",
 "uid": "isms-compliance",
 "description": "Compliance posture of the cisotop platform against BSI Grundschutz++, derived from the committed assessment in the internal GitLab repository isms/compliance-as-code. Every value comes from scripts/metrics.py in that repository; nothing here recomputes a verdict. Read the top row first: an assessment of stale evidence is not an assessment, and a compliance figure without its evidence-basis split is the most misleading number this dashboard can show.",
 "tags": [
  "isms",
  "compliance",
  "security"
 ],
 "timezone": "",
 "editable": true,
 "graphTooltip": 0,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5m",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Belastbarkeit der Zahlen",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Evidenz-Alter",
   "description": "Age of the committed evidence snapshot. The collector harvests at 04:00, so anything past 36 h means a harvest was missed. Above 7 days assess.py turns every machine verdict into an error rather than a pass -- which is why this panel sits above the compliance figure and not below it.",
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - isms_evidence_timestamp_seconds",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 129600
       },
       {
        "color": "red",
        "value": 604800
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Bewertung hinter Evidenz",
   "description": "Gap between the newest committed evidence and the snapshot the committed assessment was actually computed from. Non-zero means the collector has delivered newer evidence that nobody has assessed yet, so the verdicts below describe an older cluster. A single 'last updated' field would hide exactly this.",
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 5,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "isms_evidence_timestamp_seconds - isms_assessment_timestamp_seconds",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       },
       {
        "color": "red",
        "value": 86400
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Exporter: letzter Abruf",
   "description": "Age of the exporter's last successful read from GitLab. The exporter keeps serving the last good body during an outage, so this is the only thing that reveals it -- the ISMS values themselves are absolute timestamps and simply keep ageing.",
