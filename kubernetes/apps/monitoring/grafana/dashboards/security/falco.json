{
 "title": "Falco \u2014 Runtime Security",
 "uid": "falco-runtime",
 "tags": [
  "falco",
  "security"
 ],
 "description": "Falco watches kernel syscalls on every worker. Its metrics were never collected until 2026-09-20 -- the chart value said serviceMonitor.enabled, and the key is serviceMonitor.create, so the falco-metrics Service sat there with nothing pointed at it.\n\nRead the drop counter first. A Falco that is dropping events is indistinguishable, from the alert side, from a Falco that sees nothing suspicious.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "timezone": "",
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Dropped events",
   "description": "Events Falco produced but could not deliver. Anything above zero is a blind spot, not a performance note.",
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(falcosecurity_falco_outputs_queue_num_drops_total)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
