  {
   "id": 7,
   "type": "timeseries",
   "title": "Matches by rule",
   "description": "Per minute. A rule that fires constantly is usually noise worth tuning out in customRules rather than a standing attack.",
   "gridPos": {
    "h": 9,
    "w": 14,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (rule_name) (rate(falcosecurity_falco_rules_matches_total[10m])) * 60",
     "legendFormat": "{{rule_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
