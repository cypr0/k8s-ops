{
 "title": "Open WebUI",
 "uid": "open-webui",
 "tags": [
  "open-webui",
  "apps",
  "ai"
 ],
 "description": "Open WebUI cannot be scraped: it only pushes OTLP. These metrics arrive via Alloy's otelcol receiver and are remote-written into Prometheus.\n\nThe documentation promises only http.server.requests and http.server.duration; in practice it also emits webui_users_*, which is what the top row is built on. The edge view at the bottom comes from Envoy and needs no agent at all -- useful as a cross-check, since it keeps working if the OTLP path breaks.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "timezone": "",
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
