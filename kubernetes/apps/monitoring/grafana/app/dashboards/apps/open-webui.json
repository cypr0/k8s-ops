  {
   "id": 7,
   "type": "timeseries",
   "title": "Requests by route",
   "description": "Routes appear as they are first used, so a fresh restart shows only /health until someone opens the UI.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (http_route) (rate(http_server_requests_total[5m])) * 60",
