{
 "title": "Flux \u2014 GitOps Reconciliation",
 "uid": "flux-gitops",
 "tags": [
  "flux",
  "gitops",
  "platform"
 ],
 "description": "Built here because no community dashboard fits: the widely-linked Flux2 dashboard (gnetId 16714) queries gotk_reconcile_condition, which current Flux no longer emits. What does exist is flux_resource_info from flux-operator -- one series per managed object, carrying ready, reason, suspended and revision -- plus gotk_reconcile_duration_seconds from the controllers themselves.\n\nEverything in this cluster is deployed through Flux, so a Kustomization that quietly stops reconciling means the cluster has silently stopped following Git. That is what the top row is for.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timezone": "",
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Not ready",
   "description": "Managed objects whose Ready condition is False. Anything above zero means Git and the cluster have diverged.",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(flux_resource_info{ready=\"False\"}) or vector(0)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Suspended",
   "description": "Deliberately paused, so not an error -- but a suspended Kustomization silently ignores Git until someone resumes it.",
