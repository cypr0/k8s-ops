     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(histogram_quantile(0.95, sum by (le) (rate(gotk_reconcile_duration_seconds_bucket[30m]))))"
