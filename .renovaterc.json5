{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // 2.2.0's default.json cross-referenced its own sibling files (e.g.
  // //config/baseConfig.json5) WITHOUT a pinned ref, and Renovate resolves
  // unpinned nested extends against the repo's current default branch, not
  // the tag used on the parent reference. Upstream restructured at 7.0.0
  // ("consolidate the general-purpose presets into default.json"), deleting
  // those paths from the default branch — so the 2.2.0 pin stopped working
  // even though tag 2.2.0 itself is untouched. Fixed upstream in 7.0.0 by
  // making default.json fully self-contained (no internal cross-references),
  // so a single tag now reliably pins the whole thing again. App-specific
  // extras (CNPG, Grafana dashboards, Talos factory schematics — all used in
  // this cluster) moved to opt-in apps/ presets and, per the README, need
  // their own separate pin since a tag never propagates across a path-based
  // extends.
  extends: [
    "github>home-operations/renovate-presets#7.0.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#7.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#7.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#7.0.0",
  ],
  schedule: ["every weekend"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["every weekend"],
  },
  packageRules: [
    {
      description: "Auto-merge all patches and digests",
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      description: "velero-plugin-for-aws: needs manual verification against Intercolo S3 before any bump (past silent regression broke uploads, see kubernetes/apps/velero/app/helmrelease.yaml)",
      matchPackageNames: ["velero/velero-plugin-for-aws"],
      enabled: false,
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
